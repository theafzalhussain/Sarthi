# ============================================================
#  SAARTHI — Configuration
#  Isko copy karke ".env" naam se save kar, phir keys daal.
#     cp .env.example .env
# ============================================================

# ------------------------------------------------------------
#  BRAIN — LLM Providers (sab FREE tier)
#  Kam se kam EK key daal. Dono daale to best hoga.
# ------------------------------------------------------------

# GROQ — Sabse zyada free requests/day, bahut fast.
# Key yahan se le (free, no credit card): https://console.groq.com
GROQ_API_KEY=

# GEMINI — Vision support (screenshot dekhne ke liye ZARURI hai).
# Key yahan se le (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NVIDIA NIM — YE EK KEY SE 4 MODELS CHALTE HAIN:
#
#   nvidia    -> Nemotron 3 Ultra (550B)      smart, agentic, tools
#   deepseek  -> DeepSeek V4 Pro (1.6T MoE)   SABSE smart, 1M context
#   muse      -> Meta Muse Glimmer 30B        tools + AANKH (screenshot)
#   gemma     -> Google DiffusionGemma 26B    aankh, tools bharosemand nahi
#
# Matlab ek hi free key se 4 fallback slots mil jaate hain. Ek model
# 404 de ya limit khatam ho to agla automatic try hota hai.
#
# Key yahan se le (free): https://build.nvidia.com
# (key "nvapi-" se shuru hoti hai)
NVIDIA_API_KEY=

# Kisi model ke liye ALAG key mil jaaye to yahan daal de. Khali chhod
# de to upar wali NVIDIA_API_KEY hi use hogi.
# DEEPSEEK_API_KEY=
# MUSE_API_KEY=
# GEMMA_API_KEY=

# OPENROUTER — Backup, bahut models ek jagah.
# Key yahan se le (free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# BLUESMINDS — Multi-model gateway. Ek key se GPT-5.6, GPT-4o,
# GLM-5.2 sab chal jaate hain.
# Key yahan se le: https://api.bluesminds.com
# GPT-4o ke saath VISION bhi support hota hai (screenshot dekh sakta hai)
BLUESMINDS_API_KEY=


# ------------------------------------------------------------
#  MODEL SELECTION
#
#  ⚠️ MODEL NAAM BADALTE REHTE HAIN. Providers purane models band
#  kar dete hain (Groq ne June 2026 mein llama-3.3-70b band kiya).
#
#  Agar "model_not_found" ya HTTP 404 error aaye:
#      1. CLI mein chala:  /models
#      2. Wo LIVE dikhayega kaunse models available hain
#      3. Naam yahan update kar de
#
#  Ye lines comment (#) rehne do to code ke defaults use honge —
#  wahi sabse safe hai.
# ------------------------------------------------------------

# GROQ_MODEL=openai/gpt-oss-20b
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_MODEL=openrouter/free

# --- NVIDIA pe hosted teen aur models ---
# DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro
#   Chhota/tez version chahiye? deepseek-ai/deepseek-v4-flash
# MUSE_MODEL=meta/muse-glimmer-30b
# GEMMA_MODEL=google/diffusiongemma-26b-a4b-it


# ------------------------------------------------------------
#  MODEL CAPABILITIES — kaunsa model kya kar sakta hai
#
#  SAARTHI ka pura kaam TOOL CALLING se hota hai (app kholo, tap
#  karo, search karo). Jo model tools support nahi karta wo sirf
#  baat kar sakta hai, KAAM nahi kar sakta.
#
#  Isliye SAARTHI tool wale kaam ke liye aise models ko PEECHE
#  dhakel deta hai (hataata nahi — backup ke liye rakhta hai).
#
#  Ye sab AUTO-DETECT nahi hota, isliye override de rahe hain.
#  Model update ho jaaye aur capability badle to yahan set kar de.
# ------------------------------------------------------------

# DiffusionGemma diffusion-based model hai — iska tool calling
# verify nahi hua, isliye default OFF hai.
# Tere paas chal jaaye to true kar de:
# GEMMA_TOOLS=false

# Muse Glimmer multimodal hai (text + image) aur native tool
# calling karta hai — dono default ON hain.
# MUSE_TOOLS=true
# MUSE_VISION=true

# DeepSeek text-only hai par agentic kaam ke liye bana hai.
# DEEPSEEK_TOOLS=true

# Gemma image/video input leta hai.
# GEMMA_VISION=true

# Bluesminds — jo model select kiya tha wo yahan likh:
#   gpt-5.6-sol      -> frontier reasoning (sabse smart)
#   gpt-4o           -> fast + VISION (screenshot dekh sakta hai!)
#   glm-5.2          -> strong all-rounder
# Default gpt-4o hai — kyunki vision + tez dono.
# BLUESMINDS_MODEL=gpt-4o


# ------------------------------------------------------------
#  PROVIDER ORDER — kaunsa pehle try kare
#
#  Default:
#      groq -> nvidia -> deepseek -> muse -> bluesminds
#           -> openrouter -> gemini -> gemma
#
#  Kyun ye order:
#    groq     pehle  -> sabse TEZ, aur ISKI KEY ALAG hai (load bantta hai)
#    nvidia   phir   -> nemotron, smart + agentic
#    deepseek phir   -> sabse smart, par bada/dheema
#    muse     phir   -> vision + tools dono, gemini se pehle
#    gemma    aakhir -> tool calling bharosemand nahi
#
#  DHYAN: nvidia, deepseek, muse, gemma SAARE ek hi NVIDIA key pe
#  chalte hain. Us key ki limit khatam ho to chaaron ruk jaayenge —
#  isliye ek doosre provider (groq/gemini) ki key bhi rakhna.
#
#  DeepSeek pehle chahiye (sabse smart)?
#      SAARTHI_PROVIDER_ORDER=deepseek,groq,nvidia,muse
#
#  Sirf ek model use karna hai?
#      SAARTHI_PROVIDER_ORDER=deepseek
#
#  Note: screenshot wala kaam AUTOMATICALLY vision waale model ko
#  jaata hai (muse / gemini / gemma) — order sirf unke beech
#  priority decide karta hai.
# ------------------------------------------------------------
# SAARTHI_PROVIDER_ORDER=groq,nvidia,deepseek,muse,bluesminds,openrouter,gemini,gemma


# ------------------------------------------------------------
#  BEHAVIOUR
# ------------------------------------------------------------

# Agent kis bhasha mein jawab de: hinglish | hindi | english
SAARTHI_LANGUAGE=hinglish

# Risky kaam (paise, delete, message bhejna) se pehle puchega?
# true rakhna. Isko false karna khatarnak hai.
SAARTHI_CONFIRM_RISKY=true

# Ek command ke liye max kitne steps le sakta hai
SAARTHI_MAX_STEPS=12

# Debug logs dikhane hain?
SAARTHI_DEBUG=false


# ------------------------------------------------------------
#  DEVICE CONTROL
# ------------------------------------------------------------

# ADB binary ka path. Agar PATH mein hai to "adb" chhod de.
ADB_PATH=adb

# Kis device pe kaam karna hai default: desktop | android
SAARTHI_DEFAULT_DEVICE=desktop


# ------------------------------------------------------------
#  BROWSER — "mera tab switch ho gaya" wali problem ka ilaaj
#
#  agent  -> SAARTHI apni ALAG browser window use karega (Playwright).
#            Tere personal Chrome ke tabs ko haath bhi nahi lagega.
#            SABSE SAFE. Ek baar sites pe login karna padega —
#            uske baad login yaad rehta hai.
#            Chahiye: pip install playwright && playwright install chromium
#
#  system -> Tera default browser. Agent NAYE TAB mein kholega (tera
#            current tab replace nahi karega) aur window ko zabardasti
#            aage laane ki koshish nahi karega.
#            IMAANDAAR BAAT: Chrome khud naye tab pe switch kar deta hai.
#            Ye Chrome ka behaviour hai, code se nahi rok sakte.
#            Tab switch bilkul nahi chahiye to 'agent' use kar.
#
#  auto   -> Playwright installed ho to 'agent', warna 'system'.
#            DEFAULT — bina setup ke sahi kaam karta hai.
# ------------------------------------------------------------
SAARTHI_BROWSER_MODE=auto

# Agent ka browser dikhe ya nahi.
#   false -> dikhega (default). User dekh sakta hai kya ho raha hai,
#            aur chahe to khud takeover kar sakta hai.
#   true  -> background mein, koi window nahi khulegi.
#            Focus bilkul nahi chheenna ho to ye use kar — par phir
#            "me waha chala jata hun" nahi ho payega.
SAARTHI_BROWSER_HEADLESS=false


# ------------------------------------------------------------
#  LOOK (terminal ka dikhawa)
# ------------------------------------------------------------

# Purana Windows terminal hai aur box/symbols toote dikh rahe hain?
# Koi bhi value daal do, ASCII-only mode chalu ho jaayega.
# SAARTHI_ASCII_UI=1

# Rang aur box bilkul nahi chahiye (log file mein bhejna hai)?
# SAARTHI_PLAIN_UI=1



# ============================================================
#  VOICE (Phase 2) — sab optional
#  Setup check: python voice_cli.py --check
# ============================================================

# ------------------------------------------------------------
#  SUNNA (Speech-to-Text) — Whisper, offline aur free
# ------------------------------------------------------------

# Model size. Chhota = tez + kam RAM.
#   tiny   -> ~1GB RAM, bahut tez, accuracy kaam chalau
#   base   -> ~1GB RAM, tez            <- 4GB laptop ke liye
#   small  -> ~2GB RAM, acchi accuracy <- recommended
#   medium -> ~5GB RAM, bahut acchi
WHISPER_MODEL=base

# cpu | cuda
WHISPER_DEVICE=cpu

# int8 = kam RAM | float16 = GPU pe fast
WHISPER_COMPUTE=int8

# IMPORTANT (Hinglish ke liye):
#   en   -> roman script mein output ("paytm kholo")     <- DEFAULT
#   hi   -> Devanagari mein output ("पेटीएम खोलो")
#   auto -> khud detect kare
# "en" rakhna better hai kyunki hamara pura lexicon roman mein hai.
WHISPER_LANGUAGE=en

# Zyada beam = better accuracy par dheemi
WHISPER_BEAM_SIZE=5


# ------------------------------------------------------------
#  BOLNA (Text-to-Speech)
# ------------------------------------------------------------

# auto | piper | espeak | say | pyttsx3 | null
# auto sabse accha available backend khud chun leta hai
TTS_BACKEND=auto

# Piper voice model ka path (best quality chahiye to)
# Free models: https://huggingface.co/rhasspy/piper-voices
# PIPER_MODEL=/home/tu/.local/share/piper/voices/en_US-amy-medium.onnx

# espeak voice — en-in = Indian English (Hinglish ke liye best)
ESPEAK_VOICE=en-in

# Bolne ki speed (1.0 = normal)
TTS_SPEED=1.0

# Ek baar mein max kitne characters bolna
TTS_MAX_CHARS=500


# ------------------------------------------------------------
#  JAGANA (Wake mode)
# ------------------------------------------------------------

# push_to_talk -> Enter dabao, bolo. ZERO SETUP.  <- DEFAULT, isse shuru kar
# energy       -> koi bhi tez awaaz (TV se bhi trigger ho jaata hai)
# porcupine    -> asli wake word, free key chahiye
WAKE_MODE=push_to_talk

# --- Porcupine ke liye (WAKE_MODE=porcupine) ---
# Free key: https://console.picovoice.ai/
# PORCUPINE_ACCESS_KEY=

# Built-in keywords: jarvis, computer, alexa, hey google, hey siri,
# porcupine, bumblebee, terminator, blueberry, grasshopper, ...
# ("saarthi" built-in nahi hai — neeche dekh)
PORCUPINE_KEYWORD=jarvis

# Apna "Hey Saarthi" chahiye? Picovoice Console pe FREE train kar,
# .ppn file download kar, phir yahan path de:
# PORCUPINE_KEYWORD_PATH=/path/to/hey_saarthi.ppn

# 0-1. Zyada = jaldi trigger (par false alarms bhi zyada)
PORCUPINE_SENSITIVITY=0.5

# --- Energy mode ke liye ---
WAKE_ENERGY_THRESHOLD=1500


# ------------------------------------------------------------
#  VOICE BEHAVIOUR
# ------------------------------------------------------------

# Agent jawab bolke sunaye?
VOICE_SPEAK_REPLIES=true

# Risky kaam (paise, delete) ki confirmation BOLKE le?
# true rakhna. Isse tu "haan"/"nahi" bolke confirm karta hai.
VOICE_CONFIRMATIONS=true
