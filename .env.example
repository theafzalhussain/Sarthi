# ============================================================
#  SAARTHI — Configuration
#  Isko copy karke ".env" naam se save kar, phir keys daal.
#     cp .env.example .env
# ============================================================

# ------------------------------------------------------------
#  BRAIN — LLM Providers (sab FREE tier)
#  Kam se kam EK key daal. Dono daale to best hoga.
# ------------------------------------------------------------

# GROQ — Sabse zyada free requests/day, bahut fast.
# Key yahan se le (free, no credit card): https://console.groq.com
GROQ_API_KEY=

# GEMINI — Vision support (screenshot dekhne ke liye ZARURI hai).
# Key yahan se le (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NVIDIA NIM — YE EK KEY SE 4 MODELS CHALTE HAIN:
#
#   nvidia    -> Nemotron 3 Ultra (550B)      smart, agentic, tools
#   deepseek  -> DeepSeek V4 Pro (1.6T MoE)   SABSE smart, 1M context
#   muse      -> Meta Muse Glimmer 30B        tools + AANKH (screenshot)
#   gemma     -> Google DiffusionGemma 26B    aankh, tools bharosemand nahi
#
# Matlab ek hi free key se 4 fallback slots mil jaate hain. Ek model
# 404 de ya limit khatam ho to agla automatic try hota hai.
#
# Key yahan se le (free): https://build.nvidia.com
# (key "nvapi-" se shuru hoti hai)
NVIDIA_API_KEY=

# Kisi model ke liye ALAG key mil jaaye to yahan daal de. Khali chhod
# de to upar wali NVIDIA_API_KEY hi use hogi.
# DEEPSEEK_API_KEY=
# MUSE_API_KEY=
# GEMMA_API_KEY=

# OPENROUTER — Backup, bahut models ek jagah.
# Key yahan se le (free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# BLUESMINDS — Multi-model gateway. Ek key se GPT-5.6, GPT-4o,
# GLM-5.2 sab chal jaate hain.
# Key yahan se le: https://api.bluesminds.com
# GPT-4o ke saath VISION bhi support hota hai (screenshot dekh sakta hai)
BLUESMINDS_API_KEY=

# OPENCODE ZEN — Coding agents ke liye curated models.
# Ek key se Laguna S 2.1, DeepSeek V4 Flash, Nemotron Ultra — sab FREE
# models milte hain. 256K context, 32K output. Tool calling supported.
# Key yahan se le (free): https://opencode.ai/zen -> API Keys
OPENCODE_API_KEY=


# ------------------------------------------------------------
#  MODEL SELECTION
#
#  ⚠️ MODEL NAAM BADALTE REHTE HAIN. Providers purane models band
#  kar dete hain (Groq ne June 2026 mein llama-3.3-70b band kiya).
#
#  Agar "model_not_found" ya HTTP 404 error aaye:
#      1. CLI mein chala:  /models
#      2. Wo LIVE dikhayega kaunse models available hain
#      3. Naam yahan update kar de
#
#  Ye lines comment (#) rehne do to code ke defaults use honge —
#  wahi sabse safe hai.
# ------------------------------------------------------------

# GROQ_MODEL=openai/gpt-oss-20b
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# GEMINI_MODEL=gemini-3.6-flash
# OPENROUTER_MODEL=openrouter/free

# --- NVIDIA pe hosted teen aur models ---
# DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-pro-0813
#   Dhyan: bina "-0813" wala version 2026-08-07 pe EOL ho gaya.
#   Chhota/tez version chahiye? deepseek-ai/deepseek-v4-flash
# MUSE_MODEL=meta/muse-glimmer-30b
# GEMMA_MODEL=google/diffusiongemma-26b-a4b-it


# ------------------------------------------------------------
#  GENERATION TUNING — jawab kaisa aaye
#
#  Global (saare providers pe lagta hai):
#      SAARTHI_MAX_TOKENS=4096
#
#  Per-provider (global se JEETTA hai):
#      {NAME}_MAX_TOKENS        jawab ki max length
#      {NAME}_TOP_P             sampling (0-1)
#      {NAME}_ENABLE_THINKING   reasoning on/off (NVIDIA models)
#
#  {NAME} = GROQ | NVIDIA | DEEPSEEK | MUSE | GEMMA | GEMINI |
#           OPENROUTER | BLUESMINDS
#
#  ⚠️ max_tokens KHAAS ZAROORI hai reasoning models ke liye.
#  Thinking ON ho to reasoning tokens BHI isi budget se khaate hain.
#  Budget chhota hua to jawab BEECH MEIN KAT jaata hai.
#  Nemotron/DeepSeek pe thinking ON karna hai to 16384 rakh.
# ------------------------------------------------------------

# SAARTHI_MAX_TOKENS=4096

# Nemotron ko soch ke jawab dene do? true = better quality, thoda dheema
# NVIDIA_ENABLE_THINKING=true
# NVIDIA_MAX_TOKENS=16384
# NVIDIA_TOP_P=0.95

# DeepSeek ka thinking DEFAULT OFF hai (warna pura chain-of-thought
# reply mein aa jaata hai). On karna hai to:
# DEEPSEEK_ENABLE_THINKING=true
# DEEPSEEK_MAX_TOKENS=16384


# ------------------------------------------------------------
#  MODEL CAPABILITIES — kaunsa model kya kar sakta hai
#
#  SAARTHI ka pura kaam TOOL CALLING se hota hai (app kholo, tap
#  karo, search karo). Jo model tools support nahi karta wo sirf
#  baat kar sakta hai, KAAM nahi kar sakta.
#
#  Isliye SAARTHI tool wale kaam ke liye aise models ko PEECHE
#  dhakel deta hai (hataata nahi — backup ke liye rakhta hai).
#
#  Ye sab AUTO-DETECT nahi hota, isliye override de rahe hain.
#  Model update ho jaaye aur capability badle to yahan set kar de.
# ------------------------------------------------------------

# DiffusionGemma diffusion-based model hai — iska tool calling
# verify nahi hua, isliye default OFF hai.
# Tere paas chal jaaye to true kar de:
# GEMMA_TOOLS=false

# Muse Glimmer multimodal hai (text + image) aur native tool
# calling karta hai — dono default ON hain.
# MUSE_TOOLS=true
# MUSE_VISION=true

# DeepSeek text-only hai par agentic kaam ke liye bana hai.
# DEEPSEEK_TOOLS=true

# Gemma image/video input leta hai.
# GEMMA_VISION=true

# Bluesminds — jo model select kiya tha wo yahan likh:
#   gpt-5.6-sol      -> frontier reasoning (sabse smart)
#   gpt-4o           -> fast + VISION (screenshot dekh sakta hai!)
#   glm-5.2          -> strong all-rounder
# Default gpt-4o hai — kyunki vision + tez dono.
# BLUESMINDS_MODEL=gpt-4o


# ------------------------------------------------------------
#  PROVIDER ORDER — kaunsa pehle try kare
#
#  ⚠️ SABSE ZAROORI BAAT: ye line COMMENTED (#) rehne do!
#
#  Agar tu yahan khud order likhega, to BAAD MEIN jo naye models
#  add honge wo SABSE AAKHIR chale jaayenge — chahe wo sabse smart
#  hon. Phir tujhe lagega "naya model kaam nahi kar raha".
#  Commented chhod de to SAARTHI khud BEST model pehle rakhta hai.
#
#  Default (best pehle):
#      deepseek -> nvidia -> muse -> groq -> bluesminds
#               -> openrouter -> gemini -> gemma
#
#  Kyun BEST pehle (aur TEZ pehle nahi):
#    Smart model ek hi prompt mein pura kaam kar deta hai.
#    Tez-par-kamzor model 3-4 baar galti karta hai, phir se try karta
#    hai — aakhir mein wahi dheema pad jaata hai aur tokens bhi
#    zyada khaata hai.
#
#    deepseek pehle  -> 1.6T MoE, 1M context, SABSE SMART
#    nvidia   phir   -> nemotron, long-running agents ke liye bana
#    muse     phir   -> vision + tools dono, aur tez bhi (30B)
#    groq     phir   -> sabse TEZ, aur ISKI KEY ALAG hai (backup)
#    gemma    aakhir -> tool calling bharosemand nahi
#
#  DHYAN: nvidia, deepseek, muse, gemma SAARE ek hi NVIDIA key pe
#  chalte hain. Us key ki limit khatam ho to chaaron ruk jaayenge —
#  isliye ek doosre provider (groq/gemini) ki key bhi rakhna.
#
#  DeepSeek pehle chahiye (sabse smart)?
#      SAARTHI_PROVIDER_ORDER=deepseek,groq,nvidia,muse
#
#  Sirf ek model use karna hai?
#      SAARTHI_PROVIDER_ORDER=deepseek
#
#  Note: screenshot wala kaam AUTOMATICALLY vision waale model ko
#  jaata hai (muse / gemini / gemma) — order sirf unke beech
#  priority decide karta hai.
# ------------------------------------------------------------
# SAARTHI_PROVIDER_ORDER=groq,nvidia,deepseek,muse,bluesminds,openrouter,gemini,gemma


# ------------------------------------------------------------
#  BEHAVIOUR
# ------------------------------------------------------------

# Agent kis bhasha mein jawab de: auto | hinglish | hindi | english
#
# auto (DEFAULT aur recommended) — USER KI BHASHA COPY karta hai:
#     Tu English mein likhega  -> English mein jawab milega
#     Tu Hinglish mein likhega -> Hinglish mein jawab milega
#     Beech mein bhasha badlega -> agent bhi badal dega
#
# Dhyan: INTERFACE (tables, commands, /help) hamesha ENGLISH mein hai
# — wo professional lagta hai. Ye setting sirf agent ki BAAT karne ki
# bhasha decide karti hai.
#
# Hamesha ek hi bhasha chahiye to "hinglish" ya "english" set kar de.
SAARTHI_LANGUAGE=auto

# Risky kaam (paise, delete, message bhejna) se pehle puchega?
# true rakhna. Isko false karna khatarnak hai.
SAARTHI_CONFIRM_RISKY=true

# FULL ACCESS MODE — risky kaam bina puche karega.
#
# Isse ye AUTO-APPROVE hote hain:
#   shell command chalana, skill chalana, memory delete
#
# Isse ye PHIR BHI BLOCKED rehte hain (chahe true kar do):
#   OTP / PIN / password / CVV type karna
#   rm -rf /, mkfs, fork bomb, curl | bash, shutdown
#   final payment button dabana
# Ye HARD BLOCKS hain — safety.py mein alag layer hai, koi setting
# inko bypass nahi karti. Ye design hai, bug nahi.
#
# CLI mein chalte-chalte toggle bhi kar sakta hai: /auto
SAARTHI_AUTO_APPROVE=false

# Ek command ke liye max kitne steps le sakta hai.
#
# 25 rakha hai kyunki "youtube pe gaana chala do" jaisa kaam 6-8 step
# leta hai (site kholo -> page padho -> video pe click -> verify).
# Kam rakha to agent kaam ADHOORA chhod dega.
# Free tier ke tokens bachane hain to 15 kar de.
SAARTHI_MAX_STEPS=25

# Screenshot caching — free tier tokens bachao
# Kitne screenshots ek turn mein LLM ko bhejne hain (purane auto-evict)
SAARTHI_MAX_SCREENSHOTS=2
# Same screenshot dobara aaye to skip karo (hash match)
SAARTHI_SCREENSHOT_DEDUPE=true

# Debug logs dikhane hain?
SAARTHI_DEBUG=false


# ------------------------------------------------------------
#  DEVICE CONTROL
# ------------------------------------------------------------

# ADB binary ka path. Agar PATH mein hai to "adb" chhod de.
ADB_PATH=adb

# Kis device pe kaam karna hai default.
#
# SIRF ye teen values chalti hain: desktop | android | browser
#
# ⚠️ YE MIC KI SETTING NAHI HAI. Ek user ne galti se yahan
# "Realtek" likh diya tha — mic ka naam samajh ke. Mic ke liye
# SAARTHI_MIC_DEVICE hai (neeche VOICE section mein).
# Galat value daalne pe chup-chaap "desktop" use hota hai.
SAARTHI_DEFAULT_DEVICE=desktop

# Multiple phones connected? Pin a specific one by serial.
# Run 'adb devices' to see serials. Leave empty = first phone auto-selected.
# SAARTHI_ANDROID_SERIAL=


# ------------------------------------------------------------
#  BROWSER — "mera tab switch ho gaya" wali problem ka ilaaj
#
#  agent  -> SAARTHI apni ALAG browser window use karega (Playwright).
#            Tere personal Chrome ke tabs ko haath bhi nahi lagega.
#            SABSE SAFE. Ek baar sites pe login karna padega —
#            uske baad login yaad rehta hai.
#            Chahiye: pip install playwright && playwright install chromium
#
#  system -> Tera default browser. Agent NAYE TAB mein kholega (tera
#            current tab replace nahi karega) aur window ko zabardasti
#            aage laane ki koshish nahi karega.
#            IMAANDAAR BAAT: Chrome khud naye tab pe switch kar deta hai.
#            Ye Chrome ka behaviour hai, code se nahi rok sakte.
#            Tab switch bilkul nahi chahiye to 'agent' use kar.
#
#  auto   -> Playwright installed ho to 'agent', warna 'system'.
#            DEFAULT — bina setup ke sahi kaam karta hai.
# ------------------------------------------------------------
SAARTHI_BROWSER_MODE=auto

# Agent ka browser dikhe ya nahi.
#   false -> dikhega (default). User dekh sakta hai kya ho raha hai,
#            aur chahe to khud takeover kar sakta hai.
#   true  -> background mein, koi window nahi khulegi.
#            Focus bilkul nahi chheenna ho to ye use kar — par phir
#            "me waha chala jata hun" nahi ho payega.
SAARTHI_BROWSER_HEADLESS=false


# ------------------------------------------------------------
#  LOOK (terminal ka dikhawa)
# ------------------------------------------------------------

# Purana Windows terminal hai aur box/symbols toote dikh rahe hain?
# Koi bhi value daal do, ASCII-only mode chalu ho jaayega.
# SAARTHI_ASCII_UI=1

# Rang aur box bilkul nahi chahiye (log file mein bhejna hai)?
# SAARTHI_PLAIN_UI=1



# ============================================================
#  VOICE (Phase 2) — sab optional
#  Setup check: python voice_cli.py --check
# ============================================================

# ------------------------------------------------------------
#  SUNNA (Speech-to-Text) — Whisper, offline aur free
# ------------------------------------------------------------

# Model size. Chhota = tez + kam RAM, PAR Hinglish pe kamzor.
#
#   tiny   -> ~1GB RAM, bahut tez, accuracy kaam chalau
#   base   -> ~1GB RAM, tez            <- sirf 4-6GB laptop ke liye
#   small  -> ~2GB RAM, acchi accuracy <- 8GB+ pe YAHI use kar
#   medium -> ~5GB RAM, bahut acchi    <- 12GB+ pe
#
# ⚠️ ASLI PROBLEM JO MILI: 'base' code-switched Hinglish pe theek se
# kaam nahi karta. Ek user ne "paytm kholo" bola aur base ne suna
# "Kya kya ouri website, proper da yaar uca" — audio quality perfect
# thi (peak 24087). Model hi kamzor tha.
#
# Tera machine kaunsa chala sakta hai wo pata karne ke liye:
#     python hardware_check.py --keys       (RAM + suggestion dikhata hai)
#
# Aur kaunsi setting TERI AWAAZ pe best hai wo MEASURE karne ke liye:
#     python hardware_check.py --stt-tune
# Wo ek recording pe saari settings try karke score deta hai.
WHISPER_MODEL=small

# ------------------------------------------------------------
#  MICROPHONE — kaunsa mic use karna hai
#
#  ⚠️ YE SETTING BAHUT KAAM KI HAI. Asli problem jo mili:
#  Windows pe system default aksar "Microsoft Sound Mapper - Input"
#  hota hai (legacy MME wrapper). Usse recording AATI hai par bahut
#  DHEEMI — peak sirf ~300 out of 32767, practically silence. Whisper
#  ko kuch sunai nahi deta aur lagta hai voice tuta hua hai.
#
#  Kaunsa mic sahi hai wo PATA KARNE ke liye chala:
#      python hardware_check.py --mic-scan
#  Wo har mic se record karke batayega kaunsa sach mein sunta hai.
#
#  NAAM se likhna BEHTAR hai (index se nahi) — index reboot pe ya
#  USB mic nikaalne-lagane pe badal jaata hai, naam same rehta hai.
#      SAARTHI_MIC_DEVICE=Microphone Array (Realtek(R) Audio)
#      SAARTHI_MIC_DEVICE=Realtek        <- hissa bhi chalega
#      SAARTHI_MIC_DEVICE=5              <- index bhi chalega
#
#  Khali chhod de to system default use hoga.
# ------------------------------------------------------------
# SAARTHI_MIC_DEVICE=

# Silence detection ka minimum threshold (int16 scale, 0-32767).
# Mic bahut dheema ho aur "kuch suna hi nahi" aata rahe to isko kam
# kar (jaise 150). Bahut shor ho to badha (jaise 600).
# SAARTHI_MIC_MIN_THRESHOLD=300

# ------------------------------------------------------------
#  STREAM CONFIG — ye 99% logon ko CHHEDNE KI ZARURAT NAHI
#
#  ⚠️ YE DO KNOB EK ASLI BUG SE AAYE HAIN (BUG#22).
#
#  User ki machine pe mic se sirf ZEROS aa rahe the:
#      sd.rec()      (callback)  -> peak 16105  ✅ audio aaya
#      stream.read() (blocking)  -> 333 chunk, HAR EK rms 0
#
#  Ek hi device, ek hi samplerate/channels/dtype. Wajah: PortAudio ka
#  backend (MME / WASAPI / WDM-KS) har machine pe alag behave karta
#  hai. Hum ab callback-based stream use karte hain, jo zyada reliable
#  hai — isliye default mein ye knob chhune ki zarurat nahi.
#
#  Par agar phir bhi mic se 0 aaye, to GUESS mat kar — MEASURE kar:
#      python hardware_check.py --mic-stream
#
#  Wo 8 alag config try karta hai aur batata hai kaunsa audio deta
#  hai, aur neeche wali exact line de deta hai.
#
#  blocksize: 0 = PortAudio khud decide kare
#             (khali chhod de = hamara 30ms chunk, ye default hai)
#  latency:   low | high — "high" bada buffer deta hai,
#             thoda dheema par zyada reliable
# ------------------------------------------------------------
# SAARTHI_MIC_BLOCKSIZE=0
# SAARTHI_MIC_LATENCY=high


# cpu | cuda
WHISPER_DEVICE=cpu

# int8 = kam RAM | float16 = GPU pe fast
WHISPER_COMPUTE=int8

# IMPORTANT (Hinglish ke liye):
#   en   -> roman script mein output ("paytm kholo")     <- DEFAULT
#   hi   -> Devanagari mein output ("पेटीएम खोलो")
#   auto -> khud detect kare
# "en" usually better hai kyunki hamara pura lexicon roman mein hai.
# PAR ye teri awaaz aur accent pe depend karta hai — guess mat kar,
# measure kar:
#     python hardware_check.py --stt-tune
WHISPER_LANGUAGE=en

# ------------------------------------------------------------
#  BIASING — Whisper ko app naam pehle se batana
#
#  ⚠️ DEFAULT OFF HAI, ASLI EVIDENCE KI WAJAH SE.
#
#  User ki machine pe (audio PERFECT thi, peak 27506):
#      bola  "paytm kholo"
#      suna  'Open YouTube'   /   'Open, Growman'
#
#  "YouTube" aur "Groww" DONO biasing list mein hain, aur output mein
#  COMMA bhi tha — Whisper ne prompt ki list hi wapas ugal di.
#
#  Whisper ka initial_prompt sirf tab faayda deta hai jab audio SAAF
#  aur LAMBA ho. Chhote command ("paytm kholo" = 1 second) pe wo ULTA
#  nuksaan karta hai.
#
#  Pillar #1 ka asli kaam CORRECTION layer karta hai (65 regex rules,
#  transcribe ke BAAD chalta hai) — wo hamesha ON rehta hai aur
#  hallucinate nahi karata. "pay time cholo" -> "paytm kholo" wo hi
#  karta hai.
#
#  off   -> biasing band (DEFAULT, recommended)
#  vocab -> app naam ka word list bhejo (saaf aur lambi awaaz ho to)
# ------------------------------------------------------------
WHISPER_BIASING=off


# Zyada beam = better accuracy par dheemi
WHISPER_BEAM_SIZE=5


# ------------------------------------------------------------
#  BOLNA (Text-to-Speech)
# ------------------------------------------------------------

# auto | piper | espeak | say | pyttsx3 | null
# auto sabse accha available backend khud chun leta hai
TTS_BACKEND=auto

# Piper voice model ka path (best quality chahiye to)
# Free models: https://huggingface.co/rhasspy/piper-voices
# PIPER_MODEL=/home/tu/.local/share/piper/voices/en_US-amy-medium.onnx

# espeak voice — en-in = Indian English (Hinglish ke liye best)
ESPEAK_VOICE=en-in

# Bolne ki speed (1.0 = normal)
TTS_SPEED=1.0

# Ek baar mein max kitne characters bolna
TTS_MAX_CHARS=500


# ------------------------------------------------------------
#  JAGANA (Wake mode)
# ------------------------------------------------------------

# push_to_talk -> Enter dabao, bolo. ZERO SETUP.  <- DEFAULT, isse shuru kar
# energy       -> koi bhi tez awaaz (TV se bhi trigger ho jaata hai)
# porcupine    -> asli wake word, free key chahiye
WAKE_MODE=push_to_talk

# --- Porcupine ke liye (WAKE_MODE=porcupine) ---
# Free key: https://console.picovoice.ai/
# PORCUPINE_ACCESS_KEY=

# Built-in keywords: jarvis, computer, alexa, hey google, hey siri,
# porcupine, bumblebee, terminator, blueberry, grasshopper, ...
# ("saarthi" built-in nahi hai — neeche dekh)
PORCUPINE_KEYWORD=jarvis

# Apna "Hey Saarthi" chahiye? Picovoice Console pe FREE train kar,
# .ppn file download kar, phir yahan path de:
# PORCUPINE_KEYWORD_PATH=/path/to/hey_saarthi.ppn

# 0-1. Zyada = jaldi trigger (par false alarms bhi zyada)
PORCUPINE_SENSITIVITY=0.5

# --- Energy mode ke liye ---
WAKE_ENERGY_THRESHOLD=1500


# ------------------------------------------------------------
#  VOICE BEHAVIOUR
# ------------------------------------------------------------

# Agent jawab bolke sunaye?
VOICE_SPEAK_REPLIES=true

# Risky kaam (paise, delete) ki confirmation BOLKE le?
# true rakhna. Isse tu "haan"/"nahi" bolke confirm karta hai.
VOICE_CONFIRMATIONS=true
